# Postgres
POSTGRES_USER=gotraining
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gotraining
POSTGRES_PORT=5432

# Backend
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=gotraining;Username=gotraining;Password=changeme
Jwt__Secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
Jwt__Issuer=GoTrainingPlatform
Jwt__Audience=GoTrainingPlatform
BACKEND_PORT=5000

# Engine service
Engine__BaseUrl=http://localhost:5100
KataGoProcess__ExecutablePath=REPLACE_THIS/go-training-platform/engine/katago/squashfs-root/AppRun
KataGoProcess__ModelPath=REPLACE_THIS/go-training-platform/engine/models/REPLACE_WITH_YOUR_MODEL_NAME.bin.gz
KataGoProcess__HumanModelPath=REPLACE_THIS/go-training-platform/engine/models/REPLACE_WITH_YOUR_HUMAN_MODEL_NAME.bin.gz
KataGoProcess__ConfigPath=REPLACE_THIS/go-training-platform/engine/config/go_training_platform_config.cfg
ENGINE_PORT=5100

# Frontend
VITE_API_BASE_URL=http://localhost:5000
