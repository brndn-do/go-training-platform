# Absolute path to your clone of this repo. Every on-disk path below derives from it,
# so this is the only line that must change on a new machine.
REPO_ROOT=/absolute/path/to/go-training-platform

# Postgres
POSTGRES_USER=gotraining
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gotraining
POSTGRES_PORT=5432

# Backend
Cors__AllowedOrigins__0=http://localhost:5173
ConnectionStrings__DefaultConnection="Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
BACKEND_PORT=5000

# Data protection key ring. Provider is AzureBlob, FileSystem or Ephemeral; the settings the
# chosen provider needs are required, the rest are ignored. ApplicationName must match across
# every host sharing a key ring.
DataProtection__Provider=FileSystem
DataProtection__ApplicationName=GoTrainingPlatform
DataProtection__KeyRingPath=${REPO_ROOT}/.dataprotection-keys
# AzureBlob only. BlobUri names the blob, not its container.
# DataProtection__BlobUri=https://<account>.blob.core.windows.net/<container>/keyring.xml
# DataProtection__KeyVaultKeyUri=https://<vault>.vault.azure.net/keys/<key>

# KataGo model filenames in engine/models/ (see README step 2).
KATAGO_MODEL_FILE=kata1-zhizi-b40c768nbt-s11472M-d5982M.bin.gz
KATAGO_HUMAN_MODEL_FILE=b18c384nbt-humanv0.bin.gz

# Engine service
Engine__BaseUrl=http://localhost:5100
ENGINE_PORT=5100
KataGoProcess__ExecutablePath=${REPO_ROOT}/engine/katago/squashfs-root/AppRun
KataGoProcess__ModelPath=${REPO_ROOT}/engine/models/${KATAGO_MODEL_FILE}
KataGoProcess__HumanModelPath=${REPO_ROOT}/engine/models/${KATAGO_HUMAN_MODEL_FILE}
KataGoProcess__ConfigPath=${REPO_ROOT}/engine/config/go_training_platform_config.cfg

# Frontend
VITE_API_BASE_URL=http://localhost:5000
