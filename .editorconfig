root = true

[*.cs]
indent_style = space
indent_size = 2
tab_width = 2

# No corporate copyright header needed for a personal project.
dotnet_diagnostic.SA1633.severity = none

# Predates file-scoped namespaces; conflicts with that convention, not a real issue.
dotnet_diagnostic.SA1200.severity = none

# Noisy given modern IDE tooling; not adopting `this.`-prefixing everywhere.
dotnet_diagnostic.SA1101.severity = none

# Predates target-typed `new()`; false positive on that syntax.
dotnet_diagnostic.SA1000.severity = none

# Duplicates SA1600 (which also checks doc content, not just presence) — one source of truth.
dotnet_diagnostic.CS1591.severity = none

# Private fields use a leading underscore (_camelCase), the common .NET convention this rule forbids.
dotnet_diagnostic.SA1309.severity = none

# Require a leading underscore on private instance/mutable-static fields.
# Neither covers `private static readonly` fields.
dotnet_diagnostic.SX1309.severity = warning
dotnet_diagnostic.SX1309S.severity = warning

# Would require private static readonly fields to start upper-case.
dotnet_diagnostic.SA1311.severity = none

# Vendored third-party source — not ours to reformat or lint.
[backend/src/GoSharp/**/*.cs]
generated_code = true

# Doc analysis is intentionally off for test projects
[**/tests/**/*.cs]
dotnet_diagnostic.SA1600.severity = none

# EF-generated migrations. EF stamps the .Designer.cs and snapshot files with an
# auto-generated header but not the migration bodies, so those get linted.
[backend/src/GoTrainingPlatform.Infrastructure/Migrations/*.cs]
generated_code = true
