<Project>

  <!-- Doc-comment requirements apply to production code, not the vendored GoSharp
       (third-party) or test projects (test names carry the meaning instead). -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'GoSharp' and !$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'GoSharp'">
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>

</Project>
