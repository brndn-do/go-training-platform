{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KataGoProcessIO": {
    "ProcessShutdownGracePeriodMs": 5000
  },
  "KataGoClient": {
    "ClientShutdownGracePeriodMs": 5000
  },
  "ReadyHealthCheck": {
    "ProcessUnresponsiveThresholdMs": 10000
  },
  "LiveHealthCheck": {
    "ProcessUnresponsiveThresholdMs": 30000
  }
}
